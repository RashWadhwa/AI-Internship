# Google API Key (required for Gemini models)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Supabase MCP credentials (required for Demo 2 and Demo 3)
# Generate a Personal Access Token at: https://supabase.com/dashboard/account/tokens
# Note: this token is account-wide, not scoped to one project -- if it ever
# leaks, treat it as access to ALL your Supabase projects and rotate it.
SUPABASE_ACCESS_TOKEN=your_personal_access_token_here
SUPABASE_PROJECT_REF=your_project_ref_here

# Defaults to "true" (read-only) even if unset -- see demo2_mcp.py/
# demo3_full_system.py/streamlit_app.py. Set to "false" only for local admin
# work (schema changes, seeding data). Never set to "false" on a deployed/
# public instance -- these agents take free-text input from anyone who loads
# the page.
SUPABASE_READ_ONLY=true

# Only needed if you deploy shipping_agent.py separately for Demo 3's A2A
# piece (see ../../render.yaml). Defaults to localhost for local dev.
SHIPPING_AGENT_URL=http://localhost:8001

# Optional -- enables Langfuse tracing (all 5 entry points: demo1_routing.py,
# demo2_mcp.py, demo3_full_system.py, capstone_agent.py, streamlit_app.py).
# Without these, tracing silently no-ops and the Streamlit sidebar shows
# "Langfuse -- not connected"; nothing else breaks.
# Get keys from your Langfuse project's Settings -> API Keys page:
# https://cloud.langfuse.com (sign up if you don't have an account).
# LANGFUSE_HOST must match the region you picked when creating the project --
# https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US).
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
